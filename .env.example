# ==========================================
# Personal Finance Tracker - Environment Configuration
# ==========================================

# Security Settings
# Generate a secret key in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-example-secret-key-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
# Set USE_POSTGRES=True for PostgreSQL production; defaults to SQLite if False
USE_POSTGRES=False
DB_NAME=finance_tracker
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis Broker
# On Windows, Celery worker MUST be run with solo pool:
# celery -A celery_app worker --pool=solo --loglevel=info
CELERY_BROKER_URL=redis://localhost:6379/0

# Razorpay Payment Gateway Credentials (Test Keys)
RAZORPAY_KEY_ID=rzp_test_RcJak5fcO3zfR9
RAZORPAY_KEY_SECRET=ul8MqhYAbfpeikySEmq7vr6B

# Email Configuration
DEFAULT_FROM_EMAIL=financetracker@gmail.com
